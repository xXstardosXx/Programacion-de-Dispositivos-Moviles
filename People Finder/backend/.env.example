# ===============================================
# PeopleFinder Backend - variables de entorno
# ===============================================
# Local: copia a .env (NO se sube a Git).
# Render: pegas estas keys en Environment del Web Service.
# ===============================================

# Render asigna PORT solo; en local puedes usar 5000
PORT=5000

# Obligatorio (Atlas)
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.mongodb.net/peoplefinder?retryWrites=true&w=majority

# Obligatorio (usa un valor fuerte distinto en Render)
SESSION_SECRET=cambia-este-secreto-en-produccion

# En Render: https://TU-SERVICIO.onrender.com
# En local: http://localhost:5000
# Sirve para links de verificación / reset de contraseña en emails
APP_BASE_URL=https://TU-SERVICIO.onrender.com

# OPCIONAL. Solo si tienes web y quieres que / redirija al frontend.
# Con APK no la necesitas: déjala vacía en Render.
FRONTEND_URL=

# Resend (correos) - solo en .env local o Environment de Render, NUNCA en el código
RESEND_API_KEY=
RESEND_FROM=PeopleFinder <onboarding@resend.dev>

# En Render: false | En local: true si quieres ver tokens en logs sin correo
RESET_PASSWORD_DEBUG_TOKEN=false
