# ===============================================
# CONFIGURACIÓN PRINCIPAL DEL SERVIDOR BACKEND
# ===============================================

# Puerto donde se ejecutará el servidor (por defecto: 5000)
PORT=5000

# URI de conexión a MongoDB (Obligatorio)
# Ejemplo MongoDB Atlas: mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/peoplefinder?retryWrites=true&w=majority
# Ejemplo MongoDB Local: mongodb://localhost:27017/peoplefinder
MONGODB_URI=mongodb://localhost:27017/peoplefinder

# Clave secreta para firmar las cookies de sesión (Obligatorio en producción)
SESSION_SECRET=dev-secret-super-seguro-key-2026

# URL del Frontend (Opcional, para redirección desde la raíz /)
FRONTEND_URL=http://localhost:8081

# URL Base del servidor backend (Usado en enlaces de verificación/reset)
APP_BASE_URL=http://localhost:5000

# ===============================================
# CONFIGURACIÓN DE CORREO SMTP (OPCIONAL)
# ===============================================
# Necesario si deseas enviar emails reales de verificación o recuperación de contraseña
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-aplicacion
SMTP_FROM="PeopleFinder <tu-correo@gmail.com>"

# Modo Debug para tokens de recuperacion si SMTP no está configurado (true/false)
RESET_PASSWORD_DEBUG_TOKEN=true

# ===============================================
# RESEND (OPCIONAL - correos de verificación/reset)
# ===============================================
# NO pongas la API key real en el código. Solo en .env local o en Render Environment.
RESEND_API_KEY=
RESEND_FROM="PeopleFinder <onboarding@resend.dev>"
