{
  "info": {
    "name": "Recetas App API",
    "description": "API REST para la aplicación de recetas.\n\n**Autenticación:** La mayoría de endpoints requieren header `Authorization: Bearer {{token}}`.\n\nTras registrar o iniciar sesión, copia el `token` de la respuesta a la variable de colección `token`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "token", "value": "" },
    { "key": "groupId", "value": "" },
    { "key": "recipeId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Verifica que el servidor esté activo."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"María García\",\n  \"email\": \"maria@ejemplo.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/register",
            "description": "Registra un nuevo usuario. **Validación:** retorna 409 si el email ya existe."
          }
        },
        {
          "name": "Iniciar Sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@ejemplo.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Obtener Perfil",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Actualizar Perfil",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"María G.\",\n  \"email\": \"maria@ejemplo.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Eliminar Cuenta",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/auth/profile",
            "description": "Elimina el usuario y todos sus grupos y recetas."
          }
        }
      ]
    },
    {
      "name": "Grupos",
      "item": [
        {
          "name": "Listar Grupos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/groups"
          }
        },
        {
          "name": "Crear Grupo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('groupId', pm.response.json().group._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Desayunos\",\n  \"description\": \"Recetas para empezar el día\",\n  \"color\": \"#F4A261\"\n}"
            },
            "url": "{{baseUrl}}/groups"
          }
        },
        {
          "name": "Obtener Grupo con Recetas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/groups/{{groupId}}"
          }
        },
        {
          "name": "Actualizar Grupo",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Desayunos Saludables\",\n  \"color\": \"#2A9D8F\"\n}"
            },
            "url": "{{baseUrl}}/groups/{{groupId}}"
          }
        },
        {
          "name": "Eliminar Grupo (cascada)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/groups/{{groupId}}",
            "description": "Elimina el grupo y TODAS las recetas asociadas a él."
          }
        },
        {
          "name": "Desasociar Receta de Grupo",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/groups/{{groupId}}/recipes/{{recipeId}}",
            "description": "Quita la receta del grupo sin eliminarla de la app."
          }
        }
      ]
    },
    {
      "name": "Recetas",
      "item": [
        {
          "name": "Todas las Recetas (Generales)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/recipes",
            "description": "Lista todas las recetas ordenadas alfabéticamente por título."
          }
        },
        {
          "name": "Mis Recetas (Personales)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/recipes/mine"
          }
        },
        {
          "name": "Crear Receta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('recipeId', pm.response.json().recipe._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Avena con frutas\",\n  \"image\": \"\",\n  \"ingredients\": [\"1 taza de avena\", \"1 plátano\", \"Miel al gusto\"],\n  \"steps\": [\"Cocinar la avena con leche\", \"Agregar frutas y miel\"],\n  \"groupIds\": [\"{{groupId}}\"]\n}"
            },
            "url": "{{baseUrl}}/recipes",
            "description": "Una receta puede pertenecer a múltiples grupos via `groupIds`."
          }
        },
        {
          "name": "Obtener Receta por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/recipes/{{recipeId}}"
          }
        },
        {
          "name": "Actualizar Receta",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Avena premium con frutas\",\n  \"groupIds\": [\"{{groupId}}\"]\n}"
            },
            "url": "{{baseUrl}}/recipes/{{recipeId}}"
          }
        },
        {
          "name": "Eliminar Receta",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/recipes/{{recipeId}}"
          }
        }
      ]
    }
  ]
}
