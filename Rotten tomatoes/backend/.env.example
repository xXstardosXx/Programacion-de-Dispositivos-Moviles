# Solo local. En Render NO definas PORT (lo asigna la plataforma).
PORT=4001

# Neon (PostgreSQL serverless). Pooled connection string.
# connect_timeout alto = da tiempo a que Neon despierte si estaba suspendido.
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pool_timeout=30&pgbouncer=true

# JWT
JWT_SECRET=cambia_esto_por_algo_largo_y_aleatorio
JWT_EXPIRES_IN=7d

# RAWG (gratis) — https://rawg.io/apidocs
# Crea cuenta → Get API Key. NO pide dominio ni suscripción de pago.
RAWG_API_KEY=tu_api_key_de_rawg

# En Render: NODE_ENV=production (y el resto de variables en el panel Environment)